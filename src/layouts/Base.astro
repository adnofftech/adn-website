---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ActionBar from '@/components/ActionBar.astro';
import { seo, apercu, marque, liens } from '@/data/site';
import { url } from '@/lib/url';
import fontTitres from '@/styles/fonts/cormorant-garamond-latin-wght-normal.woff2?url';
import fontTexte from '@/styles/fonts/instrument-sans-latin-wght-normal.woff2?url';

interface Props {
  titre: string;
  description: string;
  /** Titre complet déjà formé (accueil). Sinon « Titre | LArtiste.Ink ». */
  titreComplet?: boolean;
  sansBarre?: boolean;
  classeCorps?: string;
}
const { titre, description, titreComplet = false, sansBarre = false, classeCorps = '' } = Astro.props;
const titrePage = titreComplet ? titre : `${titre} | ${seo.suffixe}`;
const canonique = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url('/og.png'), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TattooParlor',
  name: marque.nom,
  alternateName: marque.nomProfil,
  url: Astro.site?.href,
  sameAs: [liens.instagram, liens.tiktok],
  address: { '@type': 'PostalAddress', addressLocality: marque.commune, addressRegion: marque.territoire, addressCountry: 'FR' },
  areaServed: marque.territoire,
  knowsLanguage: 'fr',
};
---
<!doctype html>
<html lang={seo.langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titrePage}</title>
    <meta name="description" content={description} />
    {apercu ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonique} />}
    <meta name="theme-color" content="#0b0a0a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="preload" href={fontTitres} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontTexte} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={marque.nom} />
    <meta property="og:title" content={titrePage} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class={classeCorps}>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {!sansBarre && <ActionBar />}
  </body>
</html>

<style is:global>
  .skip {
    position: absolute; left: var(--gut); top: -100px; z-index: calc(var(--z-nav) + 1);
    padding: var(--s-3) var(--s-4); background: var(--accent); color: var(--accent-fg); text-decoration: none; border-radius: var(--r);
  }
  .skip:focus-visible { top: var(--s-3); outline-offset: 2px; }
  main:focus { outline: none; }
</style>
